# ==============================================================================
# Environment Configuration Template
# Copy this file to '.env' and fill in your actual API keys.
# DO NOT commit your real '.env' file with secret keys to GitHub!
# ==============================================================================

# Google Gemini API Key (Required for Answer Generation & optional PDF OCR fallback)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# AgentRouter API Key (Required for deepseek-v4-flash judge evaluation)
# Obtain from: https://agentrouter.org
AGENT_ROUTER_API=your_agent_router_api_key_here

# OpenRouter API Key (Optional fallback if using OpenRouter directly)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Limit questions during generation testing (e.g., 5, 10, 30, or leave empty for all)
RAG_MAX_QUESTIONS=30
